}

/**
 * Load a AIContentLifecycle entity by referenced entity.
 *
 * Accepts either an entity object or an entity type + id pair.
 * Returns a single AIContentLifecycle entity object or NULL if none found.
 *
 * @param mixed $entity_or_type
 *   Either an entity object (e.g., $node) or a string entity type (e.g., 'node').
 * @param int|null $entity_id
 *   If the first arg is a string entity type, pass the entity ID here.
 *
 * @return AIContentLifecycle|null
 *   The first matching AIContentLifecycle entity, or NULL if none found.
 */
function ai_content_lifecycle_load_by_entity($entity_or_type, $entity_id = NULL) {
  // Normalize to an entity object.
  if (is_object($entity_or_type)) {
    $entity = $entity_or_type;
  }
  else {
    if (empty($entity_or_type) || empty($entity_id)) {
      return NULL;
    }
    $loaded = entity_load($entity_or_type, [$entity_id]);
    if (empty($loaded) || empty($loaded[$entity_id])) {
      return NULL;
    }
    $entity = $loaded[$entity_id];
  }

  // Use the entity class helper if available to find lifecycle entities.
  if (class_exists('AIContentLifecycle') && method_exists('AIContentLifecycle', 'findForEntity')) {
    $found = AIContentLifecycle::findForEntity($entity);
    if (!empty($found)) {
      return reset($found);
    }
  }

  // Fallback: query the content_lifecycle table directly.
  // Ensure table exists (may have been deleted if module was uninstalled)
  if (!_ai_content_lifecycle_table_exists()) {
    return NULL;
  }

  try {
    $entity_type = $entity->entityType();
    list($id) = entity_extract_ids($entity_type, $entity);
    if (empty($id)) { return NULL; }

    $query = db_select('content_lifecycle', 'c')
      ->fields('c')
      ->condition('entity_type', $entity_type)
      ->condition('entity_id', $id)
      ->range(0, 1)
      ->execute();

    $row = $query->fetchObject();
    if ($row && !empty($row->id)) {
      $entities = entity_load('content_lifecycle', [$row->id]);
      return !empty($entities[$row->id]) ? $entities[$row->id] : NULL;
    }
  }
  catch (\Exception $e) {
    watchdog('ai_content_lifecycle', 'Error loading AIContentLifecycle for entity: @msg', ['@msg' => $e->getMessage()], WATCHDOG_WARNING);
  }

  return NULL;
}

/**
 * Implements hook_queue_info().
 */
function ai_content_lifecycle_queue_info() {
  return [
    'ai_content_lifecycle_analysis' => [
      'title' => t('AI Content Lifecycle analysis queue'),
      'worker callback' => 'ai_content_lifecycle_queue_worker',
      'cron' => ['time' => 60],
    ],
  ];
}

/**
 * Queue worker: analyze one node.
 */
function ai_content_lifecycle_queue_worker($data) {
  $nid = isset($data['nid']) ? (int) $data['nid'] : 0;
  if (!$nid) {
    return;
  }
  $node = node_load($nid);
  if (!$node || empty($node->status)) {
    return;
  }
  try {
    $analyzer = new AIContentLifecycleAnalyzer();
    $analyzer->updateContentLifecycleWithAnalysis($node, NULL);
  }
  catch (\Exception $e) {
    watchdog('ai_content_lifecycle', 'Queue worker error for nid @nid: @msg', [
      '@nid' => $nid,
      '@msg' => $e->getMessage(),
    ], WATCHDOG_WARNING);
    throw $e;
  }
}

/**
 * Queue a node for background analysis if its type is enabled.
 */
function _ai_content_lifecycle_maybe_queue($node) {
  if (empty($node->status)) {
    return;
  }
  $config = config('ai_content_lifecycle.settings');
  if (empty($config->get('auto_upsert_on_save'))) {
    return;
  }
  $enabled_types = $config->get('enabled_types') ?: [];
  if (empty($enabled_types[$node->type])) {
    return;
  }
  $queue = BackdropQueue::get('ai_content_lifecycle_analysis');
  $queue->createItem(['nid' => (int) $node->nid]);
}

/**
 * Implements hook_node_insert().
 */
function ai_content_lifecycle_node_insert($node) {
  _ai_content_lifecycle_maybe_queue($node);
}

/**
 * Implements hook_node_update().
 */
function ai_content_lifecycle_node_update($node) {
  _ai_content_lifecycle_maybe_queue($node);
}

/**
 * Implements hook_cron().
 */
function ai_content_lifecycle_cron() {
  $config = config('ai_content_lifecycle.settings');
  $batch_size = (int) ($config->get('cron_batch_size') ?: 10);
  $enabled_types = $config->get('enabled_types') ?: [];
  if (empty($enabled_types)) {
    return;
  }

  $queue = BackdropQueue::get('ai_content_lifecycle_analysis');
  $processed = 0;
  while ($processed < $batch_size) {
    $item = $queue->claimItem();
    if (!$item) {
      break;
    }
    try {
      ai_content_lifecycle_queue_worker($item->data);
      $queue->deleteItem($item);
    }
    catch (\Exception $e) {
      $queue->releaseItem($item);
    }
    $processed++;
  }

  if ($processed) {
    watchdog('ai_content_lifecycle', 'Cron processed @count node(s) from analysis queue.', [
      '@count' => $processed,
    ]);
  }
}
