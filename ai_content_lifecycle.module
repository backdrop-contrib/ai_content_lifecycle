<?php

/**
 * @file
 * Primary module hooks for ai_content_lifecycle module.
 */

/**
 * Check if the content_lifecycle table exists.
 * Returns gracefully if table is missing (module may be in transition).
 */
function _ai_content_lifecycle_table_exists() {
  return db_table_exists('content_lifecycle');
}


/**
 * Implements hook_autoload_info().
 */
function ai_content_lifecycle_autoload_info() {
  return [
    'AIContentLifecycleAnalyzer' => 'includes/AIContentLifecycleAnalyzer.inc',
    'AIContentLifecycle' => 'includes/AIContentLifecycle.inc',
  ];
}

/**
 * Implements hook_entity_info().
 */
function ai_content_lifecycle_entity_info() {
  $info = [];

  $info['content_lifecycle'] = [
    'label' => t('Content Lifecycle'),
    'plural label' => t('Content Lifecycles'),
    'controller class' => 'EntityPlusController',
    'entity class' => 'AIContentLifecycle',
    'base table' => 'content_lifecycle',
    'fieldable' => FALSE,
    'entity keys' => [
      'id' => 'id',
      'label' => 'label',
    ],
    'bundles' => [
      'content_lifecycle' => [
        'label' => t('Content Lifecycle'),
        'admin' => [
          'path' => 'admin/content/ai-content-lifecycle',
          'access arguments' => ['administer ai content lifecycle'],
        ],
      ],
    ],
    'view modes' => [
      'full' => [
        'label' => t('Full'),
        'custom settings' => FALSE,
      ],
    ],
    'uri callback' => 'entity_class_uri',
    'access callback' => 'ai_content_lifecycle_access',
    'module' => 'ai_content_lifecycle',
  ];

  return $info;
}

/**
 * Access callback for content lifecycle entities.
 */
function ai_content_lifecycle_access($op, $entity = NULL, $account = NULL) {
  if (user_access('administer ai content lifecycle', $account)) {
    return TRUE;
  }

  switch ($op) {
    case 'view':
      return user_access('view content lifecycle data', $account);
    case 'edit':
    case 'update':
      return user_access('edit content lifecycle data', $account);
    case 'create':
    case 'delete':
      return user_access('administer ai content lifecycle', $account);
  }

  return FALSE;
}

