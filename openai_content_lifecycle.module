<?php

/**
 * @file
 * Primary module hooks for openai_content_lifecycle module.
 */

/**
 * Implements hook_autoload_info().
 */
function openai_content_lifecycle_autoload_info() {
  return array(
    'OpenAIContentLifecycleAnalyzer' => 'includes/OpenAIContentLifecycleAnalyzer.inc',
    'ContentLifecycle' => 'includes/ContentLifecycle.inc',
  );
}

/**
 * Implements hook_entity_info().
 */
function openai_content_lifecycle_entity_info() {
  $info = array();
  
  $info['content_lifecycle'] = array(
    'label' => t('Content Lifecycle'),
    'plural label' => t('Content Lifecycles'),
    'controller class' => 'EntityPlusController',
    'entity class' => 'ContentLifecycle',
    'base table' => 'content_lifecycle',
    'fieldable' => FALSE,
    'entity keys' => array(
      'id' => 'id',
      'label' => 'label',
    ),
    'bundles' => array(
      'content_lifecycle' => array(
        'label' => t('Content Lifecycle'),
        'admin' => array(
          'path' => 'admin/content/content-lifecycle',
          'access arguments' => array('administer openai content lifecycle'),
        ),
      ),
    ),
    'view modes' => array(
      'full' => array(
        'label' => t('Full'),
        'custom settings' => FALSE,
      ),
    ),
    'uri callback' => 'entity_class_uri',
    'access callback' => 'openai_content_lifecycle_access',
    'module' => 'openai_content_lifecycle',
  );
  
  return $info;
}

/**
 * Access callback for content lifecycle entities.
 */
function openai_content_lifecycle_access($op, $entity = NULL, $account = NULL) {
  if (user_access('administer openai content lifecycle', $account)) {
    return TRUE;
  }
  
  switch ($op) {
    case 'view':
      return user_access('view content lifecycle data', $account);
    case 'edit':
    case 'update':
      return user_access('edit content lifecycle data', $account);
    case 'create':
    case 'delete':
      return user_access('administer openai content lifecycle', $account);
  }
  
  return FALSE;
}

/**
 * Implements hook_config_info().
 */
function openai_content_lifecycle_config_info() {
  $prefixes['openai_content_lifecycle.settings'] = array(
    'label' => t('OpenAI Content Lifecycle settings'),
    'group' => t('Configuration'),
  );
  return $prefixes;
}

/**
 * Implements hook_permission().
 */
function openai_content_lifecycle_permission() {
  return array(
    'administer openai content lifecycle' => array(
      'title' => t('Administer OpenAI Content Lifecycle'),
      'description' => t('Configure OpenAI Content Lifecycle settings and manage content analysis.'),
    ),
    'view content lifecycle data' => array(
      'title' => t('View content lifecycle data'),
      'description' => t('View AI analysis results for content.'),
    ),
    'edit content lifecycle data' => array(
      'title' => t('Edit content lifecycle data'),
      'description' => t('Edit AI analysis results and mark content as reviewed.'),
    ),
  );
}

/**
 * Implements hook_menu().
 */
function openai_content_lifecycle_menu() {
  $items = array();

  // Configuration page.
  $items['admin/config/content/openai-content-lifecycle'] = array(
    'title' => 'OpenAI Content Lifecycle',
    'description' => 'Configure content analysis settings for OpenAI Content Lifecycle.',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('openai_content_lifecycle_settings_form'),
    'access arguments' => array('administer openai content lifecycle'),
    'file' => 'openai_content_lifecycle.admin.inc',
  );

  // Batch analyze page.
  $items['admin/config/content/openai-content-lifecycle/batch'] = array(
    'title' => 'Batch analyze content',
    'description' => 'Analyze existing content in batches.',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('openai_content_lifecycle_batch_form'),
    'access arguments' => array('administer openai content lifecycle'),
    'file' => 'openai_content_lifecycle.admin.inc',
    'type' => MENU_CALLBACK,
  );

  // Main content listing page - shows all flagged content.
  $items['admin/content/content-lifecycle'] = array(
    'title' => 'Content Lifecycle',
    'description' => 'View content flagged by AI for review.',
    'page callback' => 'openai_content_lifecycle_list_page',
    'access arguments' => array('view content lifecycle data'),
    'file' => 'openai_content_lifecycle.pages.inc',
    'type' => MENU_NORMAL_ITEM,
  );

  // View individual lifecycle entity.
  $items['admin/content/content-lifecycle/%'] = array(
    'title' => 'View Content Lifecycle',
    'page callback' => 'openai_content_lifecycle_view_page',
    'page arguments' => array(3),
    'access arguments' => array('view content lifecycle data'),
    'file' => 'openai_content_lifecycle.pages.inc',
    'type' => MENU_CALLBACK,
  );

  return $items;
}

/**
 * Implements hook_theme().
 */
function openai_content_lifecycle_theme($existing, $type, $theme, $path) {
  return array(
    'openai_content_lifecycle_confirmation' => array(
      'variables' => array('confirmation' => NULL),
      'template' => 'openai-content-lifecycle-confirmation',
      'path' => backdrop_get_path('module', 'openai_content_lifecycle') . '/templates',
    ),
  );
}

/**
 * Preprocess function for openai_content_lifecycle_confirmation template.
 */
function template_preprocess_openai_content_lifecycle_confirmation(&$variables) {
  // Add necessary classes for styling.
  $variables['classes'] = array('openai-content-lifecycle-confirmation');
  
  // Add CSS.
  backdrop_add_css(backdrop_get_path('module', 'openai_content_lifecycle') . '/css/openai_content_lifecycle.css');
}


